action(rare,"PROCURAR OVOS RAROS",function()
    task.spawn(function()
        scan()
        local count=0
        for _,v in ipairs(rare:GetChildren()) do
            if v:IsA("TextLabel") and v~=rareStatus then v:Destroy() end
        end
        for _,egg in ipairs(eggs) do
            local r=string.lower(egg.rarity)
            if string.find(r,"rare") or string.find(r,"legend") or string.find(r,"myth") or string.find(r,"secret") then
                count=count+1
                if count<=50 then label(rare,egg.name.." | "..egg.rarity.." | "..egg.value,32,GREEN) end
            end
        end
        rareStatus.Text="Ovos raros identificados: "..count
    end)
end)

