local minutes=make("TextBox",{
    Size=UDim2.new(1,-5,0,35),BackgroundColor3=Color3.fromRGB(28,40,33),
    Text="25",TextColor3=WHITE,Font=Enum.Font.Gotham,TextSize=13
},events)
make("UICorner",{CornerRadius=UDim.new(0,6)},minutes)
local timerLabel=label(events,"Temporizador parado.",32)
local running=false
action(events,"INICIAR TEMPORIZADOR",function()
    if running then return end
    local total=tonumber(minutes.Text)
    if not total or total<=0 then timerLabel.Text="Digite minutos validos."; return end
    running=true
    task.spawn(function()
        local seconds=math.floor(total*60)
        while seconds>0 and running do
            timerLabel.Text=string.format("Tempo restante: %02d:%02d",math.floor(seconds/60),seconds%60)
            task.wait(1)
            seconds=seconds-1
        end
        if running then timerLabel.Text="TEMPO FINALIZADO!" end
        running=false
    end)
end)
action(events,"PARAR TEMPORIZADOR",function()
    running=false
    timerLabel.Text="Temporizador parado."
end)

