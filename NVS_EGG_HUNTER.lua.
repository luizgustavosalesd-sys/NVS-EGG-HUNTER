local rarityOrder = {
    common = 1,
    uncommon = 2,
    rare = 3,
    epic = 4,
    legendary = 5,
    mythic = 6,
    divine = 7,
    secret = 8,
    celestial = 9
}

local rarityAliases = {
    comum = "common",
    incomum = "uncommon",
    raro = "rare",
    epico = "epic",
    épico = "epic",
    lendario = "legendary",
    lendário = "legendary",
    mitico = "mythic",
    mítico = "mythic",
    divino = "divine",
    secreto = "secret"
}

local function rarityScore(value)
    local text = string.lower(tostring(value or ""))
    for alias, english in pairs(rarityAliases) do
        if string.find(text, alias, 1, true) then
            return rarityOrder[english] or 0
        end
    end

    for name, score in pairs(rarityOrder) do
        if string.find(text, name, 1, true) then
            return score
        end
    end

    return 0
end

local function readNumber(value)
    if typeof(value) == "number" then
        return value
    end

    local text = tostring(value or "")
    text = text:gsub(",", "")
    local number, suffix = text:lower():match("([%d%.]+)%s*([kmbt]?)")

    number = tonumber(number)
    if not number then
        return nil
    end

    local multipliers = {
        k = 1e3,
        m = 1e6,
        b = 1e9,
        t = 1e12
    }

    return number * (multipliers[suffix] or 1)
end

local function readInfo(object, keys)
    for _, key in ipairs(keys) do
        local attribute = object:GetAttribute(key)
        if attribute ~= nil then
            return attribute
        end

        local child = object:FindFirstChild(key, true)
        if child and child:IsA("ValueBase") then
            return child.Value
        end
    end

    return nil
end

local function isCandidate(object)
    local name = string.lower(object.Name)

    if not (object:IsA("Model")
        or object:IsA("Tool")
        or object:IsA("BasePart")) then
        return false
    end

    local blocked = {
        "fitbounds",
        "spotbottom",
        "eggpoint",
        "carrybounds",
        "spawn",
        "eggzone",
        "eggarea",
        "marker",
        "detector",
        "hitbox"
    }

    for _, word in ipairs(blocked) do
        if string.find(name, word, 1, true) then
            return false
        end
    end

    return string.find(name, "egg", 1, true) ~= nil
        or string.find(name, "ovo", 1, true) ~= nil
end

