local function clearResults()
    for _, child in ipairs(results:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
end

local function renderResults()
    clearResults()

    local query = string.lower(search.Text)
    local minimum = filterLevels[filterIndex][2]
    local displayed = 0

    table.sort(foundObjects, function(a, b)
        if sortMode == "VALOR" then
            return (a.valueNumber or -1) > (b.valueNumber or -1)
        end

        return a.score > b.score
    end)

    for _, item in ipairs(foundObjects) do
        local matchesName = query == ""
            or string.find(string.lower(item.name), query, 1, true)

        if matchesName and item.score >= minimum then
            displayed += 1

            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -5, 0, 62)
            card.BackgroundColor3 = Color3.fromRGB(31, 48, 36)
            card.BorderSizePixel = 0
            card.LayoutOrder = displayed
            card.Parent = results

            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

            local name = Instance.new("TextLabel")
            name.Size = UDim2.new(1, -12, 0, 25)
            name.Position = UDim2.fromOffset(7, 4)
            name.BackgroundTransparency = 1
            name.Text = item.name
            name.TextColor3 = GREEN
            name.Font = Enum.Font.GothamBold
            name.TextSize = 12
            name.TextXAlignment = Enum.TextXAlignment.Left
            name.TextTruncate = Enum.TextTruncate.AtEnd
            name.Parent = card

            local info = Instance.new("TextLabel")
            info.Size = UDim2.new(1, -12, 0, 23)
            info.Position = UDim2.fromOffset(7, 31)
            info.BackgroundTransparency = 1
            info.Text = "Raridade: " .. item.rarity
                .. " | Valor: " .. item.value
            info.TextColor3 = WHITE
            info.Font = Enum.Font.Gotham
            info.TextSize = 10
            info.TextXAlignment = Enum.TextXAlignment.Left
            info.TextTruncate = Enum.TextTruncate.AtEnd
            info.Parent = card
        end
    end

    status.Text = displayed .. " RESULTADO(S) EXIBIDO(S)"
end

local function scan()
    scanButton.Text = "PROCURANDO..."
    scanButton.Active = false
    status.Text = "ANALISANDO OBJETOS VISÍVEIS..."
    foundObjects = {}

    task.spawn(function()
        local descendants = Workspace:GetDescendants()
        local seen = {}

        for _, object in ipairs(descendants) do
            if isCandidate(object) and not seen[object] then
                seen[object] = true

                local rarity = readInfo(object, {
                    "Rarity", "Raridade", "EggRarity"
                })

                local value = readInfo(object, {
                    "EggValue", "Value", "Price", "Cost", "Worth"
                })

                table.insert(foundObjects, {
                    name = object.Name,
                    rarity = tostring(rarity or "Não identificada"),
                    value = tostring(value or "Não disponível"),
                    valueNumber = readNumber(value),
                    score = rarityScore(rarity)
                })
            end
        end

        renderResults()

        scanButton.Text = "ATUALIZAR BUSCA"
        scanButton.Active = true

        if #foundObjects == 0 then
            status.Text = "NENHUM OVO IDENTIFICADO"
        end
    end)
end

