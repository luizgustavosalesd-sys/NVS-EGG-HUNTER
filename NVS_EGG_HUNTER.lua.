local function readData(obj,names)
    for _,name in ipairs(names) do
        local v=obj:GetAttribute(name)
        if v~=nil then return v end
        local child=obj:FindFirstChild(name)
        if child and (child:IsA("StringValue") or child:IsA("NumberValue") or child:IsA("IntValue")) then
            return child.Value
        end
    end
    return nil
end

local function scan()
    eggs={}
    for _,obj in ipairs(Workspace:GetDescendants()) do
        local n=string.lower(obj.Name)
        if (string.find(n,"egg") or string.find(n,"ovo"))
            and (obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("BasePart")) then
            local value=tonumber(readData(obj,{"EggValue","Value","Price","Cost","Worth","Valor"})) or 0
            local rarity=tostring(readData(obj,{"Rarity","Raridade","EggRarity"}) or "Desconhecida")
            table.insert(eggs,{name=obj.Name,value=value,rarity=rarity})
        end
    end
    table.sort(eggs,function(a,b) return a.value>b.value end)
end

local function clearResults()
    for _,v in ipairs(results:GetChildren()) do
        if v:IsA("TextLabel") then v:Destroy() end
    end
end

local function render(rareOnly)
    clearResults()
    local count=0
    for _,egg in ipairs(eggs) do
        local matches=(searchText=="" or string.find(string.lower(egg.name),string.lower(searchText),1,true))
        local r=string.lower(egg.rarity)
        local isRare=string.find(r,"rare") or string.find(r,"legend") or string.find(r,"myth") or string.find(r,"secret")
        if matches and (not rareOnly or isRare) then
            count=count+1
            if count<=60 then label(results,egg.name.." | "..egg.rarity.." | Valor: "..egg.value,32,GREEN) end
        end
    end
    status.Text="Resultados encontrados: "..count
end

search:GetPropertyChangedSignal("Text"):Connect(function()
    searchText=search.Text
    render(false)
end)

action(finder,"INICIAR SCANNER",function()
